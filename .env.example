NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server-only. Never add NEXT_PUBLIC_ to this key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Enable only after applying the stage 3 migration and configuring all 3 buckets.
TEOREMA_PRODUCT_UPLOADS_ENABLED=false
# Stage 4: selection works only in local development or Vercel Preview.
# Production stays blocked until order/WhatsApp integration and release approval.
TEOREMA_CATALOG_SELECTION_ENABLED=false
# Stages 5–6: requires cart_sync + orders migrations. Preview/development only
# until integrated verification and release approval.
TEOREMA_CART_ENABLED=false

# Legacy keys are no longer used by active routes.
# If registrations contains encrypted records, preserve the original ENCRYPTION_KEY
# securely outside this repository; do not rotate/delete it without a recovery plan.
